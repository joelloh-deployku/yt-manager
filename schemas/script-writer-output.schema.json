{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Script Writer Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approval_id",
    "strategy_report_id",
    "opportunity_rank",
    "working_title",
    "title_options",
    "brief",
    "script",
    "inspiration_source_video_ids",
    "verification_notes",
    "creator_inputs_needed"
  ],
  "properties": {
    "approval_id": {"type": "integer", "minimum": 1},
    "strategy_report_id": {"type": "integer", "minimum": 1},
    "opportunity_rank": {"type": "integer", "minimum": 1},
    "working_title": {"type": "string", "minLength": 1},
    "title_options": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "viewer_problem",
        "core_promise",
        "unique_angle",
        "opening_hook",
        "proof_plan",
        "structure",
        "cta"
      ],
      "properties": {
        "viewer_problem": {"type": "string", "minLength": 1},
        "core_promise": {"type": "string", "minLength": 1},
        "unique_angle": {"type": "string", "minLength": 1},
        "opening_hook": {"type": "string", "minLength": 1},
        "proof_plan": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "structure": {
          "type": "array",
          "minItems": 3,
          "items": {"type": "string", "minLength": 1}
        },
        "cta": {"type": "string", "minLength": 1}
      }
    },
    "script": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hook", "sections", "conclusion", "cta"],
      "properties": {
        "hook": {"type": "string", "minLength": 1},
        "sections": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["heading", "narration"],
            "properties": {
              "heading": {"type": "string", "minLength": 1},
              "narration": {"type": "string", "minLength": 1}
            }
          }
        },
        "conclusion": {"type": "string", "minLength": 1},
        "cta": {"type": "string", "minLength": 1}
      }
    },
    "inspiration_source_video_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "verification_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "reason"],
        "properties": {
          "item": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "creator_inputs_needed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["placeholder", "needed"],
        "properties": {
          "placeholder": {"type": "string", "minLength": 1},
          "needed": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
