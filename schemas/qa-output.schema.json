{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hermes Content QA Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["thumbnail_report_id", "script_report_id", "status", "summary", "strengths", "findings", "recommended_next_action"],
  "properties": {
    "thumbnail_report_id": {"type": "integer", "minimum": 1},
    "script_report_id": {"type": "integer", "minimum": 1},
    "status": {"type": "string", "enum": ["PASS", "NEEDS_CHANGES"]},
    "summary": {"type": "string", "minLength": 1},
    "strengths": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_key", "severity", "area", "finding", "evidence", "recommended_action", "blocks_next_step"],
        "properties": {
          "finding_key": {"type": "string", "minLength": 1},
          "severity": {"type": "string", "enum": ["BLOCKER", "HIGH", "MEDIUM", "LOW"]},
          "area": {"type": "string", "enum": ["SCRIPT", "THUMBNAIL", "ALIGNMENT", "EVIDENCE", "CREATOR_INPUT", "FACT_CHECK", "WORKFLOW"]},
          "finding": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1},
          "recommended_action": {"type": "string", "minLength": 1},
          "blocks_next_step": {"type": "boolean"}
        }
      }
    },
    "recommended_next_action": {"type": "string", "minLength": 1}
  }
}
