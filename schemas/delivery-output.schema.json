{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["qa_report_id", "script_report_id", "thumbnail_report_id", "summary", "recording_plan", "verification_plan", "thumbnail_handoff", "asset_plan", "editing_notes", "pre_recording_checklist", "risks"],
  "properties": {
    "qa_report_id": {"type": "integer"},
    "script_report_id": {"type": "integer"},
    "thumbnail_report_id": {"type": "integer"},
    "summary": {"type": "string", "minLength": 1},
    "recording_plan": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["order", "segment_name", "script_section", "objective", "creator_inputs", "capture_notes", "b_roll"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "segment_name": {"type": "string", "minLength": 1},
          "script_section": {"type": "string", "minLength": 1},
          "objective": {"type": "string", "minLength": 1},
          "creator_inputs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "capture_notes": {"type": "string", "minLength": 1},
          "b_roll": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        }
      }
    },
    "verification_plan": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["item", "action", "required_before_recording"],
        "properties": {
          "item": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1},
          "required_before_recording": {"type": "boolean"}
        }
      }
    },
    "thumbnail_handoff": {
      "type": "object", "additionalProperties": false,
      "required": ["recommended_rank", "concept_name", "thumbnail_text", "creator_assets_needed", "capture_during_recording"],
      "properties": {
        "recommended_rank": {"type": "integer", "minimum": 1},
        "concept_name": {"type": "string", "minLength": 1},
        "thumbnail_text": {"type": "string"},
        "creator_assets_needed": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "capture_during_recording": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "asset_plan": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["asset", "source", "purpose", "required_before_recording"],
        "properties": {
          "asset": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "required_before_recording": {"type": "boolean"}
        }
      }
    },
    "editing_notes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["moment", "direction"],
        "properties": {
          "moment": {"type": "string", "minLength": 1},
          "direction": {"type": "string", "minLength": 1}
        }
      }
    },
    "pre_recording_checklist": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["item", "required", "source"],
        "properties": {
          "item": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "source": {"type": "string", "minLength": 1}
        }
      }
    },
    "risks": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
