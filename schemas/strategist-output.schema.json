{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hermes Strategist Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["research_run_id", "summary", "opportunities"],
  "properties": {
    "research_run_id": {"type": "integer", "minimum": 1},
    "summary": {"type": "string", "minLength": 1},
    "opportunities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rank",
          "working_title",
          "angle",
          "why_now",
          "audience_fit",
          "confidence",
          "source_video_ids",
          "risks"
        ],
        "properties": {
          "rank": {"type": "integer", "minimum": 1, "maximum": 3},
          "working_title": {"type": "string", "minLength": 1},
          "angle": {"type": "string", "minLength": 1},
          "why_now": {"type": "string", "minLength": 1},
          "audience_fit": {"type": "string", "minLength": 1},
          "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
          "source_video_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "risks": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
