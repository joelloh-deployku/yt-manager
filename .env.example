# Required: YouTube Data API v3 key
YOUTUBE_API_KEY=

# Comma-separated channels to monitor. @handles are recommended.
# UC... channel IDs and youtube.com/@handle URLs are also supported.
COMPETITOR_CHANNELS=@nateherk,@derekcheungsa,@AllAboutAI,@IndyDevDan,@AIAgentAutomations

# How many recent videos to inspect per channel
VIDEOS_PER_CHANNEL=15

# Number of historical recent uploads used to estimate a channel baseline
BASELINE_VIDEO_COUNT=12

# Runtime paths
DATABASE_PATH=data/yt_manager.db
OUTPUT_DIR=outputs
