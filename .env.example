# Required: YouTube Data API v3 key
YOUTUBE_API_KEY=

# Comma-separated channels to monitor. @handles are recommended.
# UC... channel IDs and youtube.com/@handle URLs are also supported.
COMPETITOR_CHANNELS=@nateherk,@derekcheungsa,@AllAboutAI,@IndyDevDan,@AIAgentAutomations

# Only uploads published within this many days are ranked as current opportunities.
CANDIDATE_WINDOW_DAYS=14

# Fetch enough uploads to provide older videos for historical baselines.
HISTORY_FETCH_COUNT=40

# Maximum current candidates to keep per channel
VIDEOS_PER_CHANNEL=15

# Number of older uploads used to estimate a channel baseline
BASELINE_VIDEO_COUNT=12

# Runtime paths
DATABASE_PATH=data/yt_manager.db
OUTPUT_DIR=outputs
